# Staging settings, read by docker compose (--env-file infra/staging.env) and scripts/staging/*.ps1.
# scripts/staging/setup.ps1 creates infra/staging.env from this template and fills in the secrets.
# Never commit infra/staging.env (it is git-ignored). Keep a copy in your password manager.

# --- Public address -----------------------------------------------------------------------------------------
# The staging site's address, as visitors type it (https, no trailing slash).
REELGUO_APP_URL=https://staging.example.com

# --- How Cloudflare reaches the server ------------------------------------------------------------------------
# tunnel: Cloudflare Tunnel (recommended; no open ports). public-port: proxied DNS to port 80 of this server.
REELGUO_STAGING_MODE=tunnel
# Tunnel token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> install connector (tunnel mode).
CLOUDFLARE_TUNNEL_TOKEN=
# Where the web container listens on this server. Tunnel mode: 127.0.0.1:8080. Public-port mode: 0.0.0.0:80.
REELGUO_WEB_BIND=127.0.0.1:8080
REELGUO_ADMIN_BIND=127.0.0.1:8081

# --- Secrets (generated by setup.ps1; changing them later signs everyone out / breaks media links) ------------
REELGUO_MEDIA_KEY=
REELGUO_JWT_KEY=
# Password of the first admin account "admin" (created once, on the first start).
REELGUO_ADMIN_PASSWORD=

# --- Search engines ---------------------------------------------------------------------------------------------
# Staging must stay out of search results: keep false.
REELGUO_ALLOW_INDEXING=false

# --- Official addresses shown on the site (optional) ------------------------------------------------------------
REELGUO_PERMANENT_DOMAIN=
REELGUO_TELEGRAM=
REELGUO_CONTACT_EMAIL=

# --- Payments (optional, off) -------------------------------------------------------------------------------------
# To try the store on staging with the sandbox provider (anyone can "pay"; never in production):
#   REELGUO_BILLING_ENABLED=true  REELGUO_PAYMENT_PROVIDER=sandbox  REELGUO_ALLOW_SANDBOX_PAYMENTS=true
#   REELGUO_SANDBOX_SECRET=<long random string>
REELGUO_BILLING_ENABLED=false
REELGUO_PAYMENT_PROVIDER=
REELGUO_ALLOW_SANDBOX_PAYMENTS=false
REELGUO_SANDBOX_SECRET=
REELGUO_BILLING_DESCRIPTOR=

# --- Backups (optional off-site copy; see infra/backup/backup.sh) ------------------------------------------------
REELGUO_BACKUP_REMOTE=
REELGUO_BACKUP_PING_URL=
