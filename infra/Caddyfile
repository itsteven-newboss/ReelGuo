# Serves the built web apps and routes /api to ASP.NET, so app and API share one origin.
{
	admin off
}

# Security headers for the web apps; keep in sync with web/security-headers.json.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# App (PWA)
:8080 {
	encode zstd gzip
	import security_headers
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health/* {
		reverse_proxy api:8080
	}
	# Media through the API's own edge (when no CDN is in front; with a CDN, media uses its own host).
	handle /media/* {
		reverse_proxy api:8080
	}
	handle {
		root * /srv/client
		# The service worker must never be cached, or clients get stuck on old versions.
		header /sw.js Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Files are served as they are. Page paths (and /) go to the API, which answers with the app's index.html plus
		# the page's title, description, canonical link and readable content for search engines (backend Seo/);
		# robots.txt and the sitemaps come from the API too. The API reads index.html from here (Seo__TemplateUrl).
		@file {
			file
			not path /
		}
		handle @file {
			file_server
		}
		handle {
			reverse_proxy api:8080
		}
	}
}

# Admin console. In production, put this behind an access gate (e.g. Cloudflare Access or an IP allowlist);
# never expose it publicly.
:8081 {
	encode zstd gzip
	import security_headers
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /media/* {
		reverse_proxy api:8080
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
