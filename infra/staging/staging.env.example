# ReelGuo staging settings (native Windows install). scripts\staging\setup.ps1 copies this file to
# C:\reelguo-staging\staging.env and fills in the secrets; the scripts read it from there. Only SYSTEM and
# Administrators can read that folder. Keep a copy of the filled-in file in your password manager. Never commit it.

# --- Public address -----------------------------------------------------------------------------------------
# The staging address visitors use (https, no trailing slash).
REELGUO_APP_URL=https://staging.example.com

# --- How Cloudflare reaches the server ------------------------------------------------------------------------
# tunnel: Cloudflare Tunnel (recommended; no open ports). public-port: proxied DNS to port 80 of this server.
REELGUO_STAGING_MODE=tunnel
# Tunnel token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel (tunnel mode).
CLOUDFLARE_TUNNEL_TOKEN=
# Public-port mode: the admin console's own address, e.g. admin.yourdomain.com (a proxied DNS record to this server,
# like the site). Protect it with Cloudflare Access. Empty: the admin console is only on this server (localhost:8081).
# Tunnel mode ignores it (add the admin host name to the tunnel instead).
REELGUO_ADMIN_HOST=
# Local ports: the app (8080 in tunnel mode, 80 in public-port mode), the admin console, the API behind them.
REELGUO_WEB_PORT=8080
REELGUO_ADMIN_PORT=8081
REELGUO_API_PORT=5080

# --- Secrets (generated by setup.ps1) ---------------------------------------------------------------------------
# Changing the media or sign-in key signs everyone out and breaks issued media links.
REELGUO_MEDIA_KEY=
REELGUO_JWT_KEY=
# Password of the first admin account "admin" (used once, to create it on the first start).
REELGUO_ADMIN_PASSWORD=
# PostgreSQL: the superuser "postgres" (maintenance only) and the app's own login.
REELGUO_PG_SUPERPASSWORD=
REELGUO_DB_NAME=reelguo
REELGUO_DB_USER=reelguo
REELGUO_DB_PASSWORD=

# --- Episode videos ------------------------------------------------------------------------------------------------
# Hls: videos are uploaded to this server and transcoded (fine for the demo content).
# Cos: the admin's browser uploads straight to a private Tencent COS bucket, laid out as
#      videos/<folder>/<title folder>/<file> (the same layout as the Viora platform), and viewers play the MP4
#      from COS with signed links. Needs H.264 + AAC MP4 files with "faststart". See docs\STAGING.md, "Tencent COS".
REELGUO_VIDEO_PROVIDER=Hls
# A CAM sub-account's key, limited to this one bucket (never the main account's key).
REELGUO_COS_SECRET_ID=
REELGUO_COS_SECRET_KEY=
# Full bucket name including the APPID, e.g. reelguo-1300000000, and its region.
REELGUO_COS_BUCKET=
REELGUO_COS_REGION=ap-singapore
# Storage folder under videos/ for uploads from the episode editor (the folder upload page lets you pick per run).
REELGUO_COS_FOLDER=reelguo
# Optional CDN domain bound to the bucket that forwards the query string. Leave empty to play from the bucket.
REELGUO_COS_CDN_HOST=
# How long a viewer's playback link and an admin's upload link work, in minutes.
REELGUO_COS_PLAYBACK_MINUTES=30
REELGUO_COS_UPLOAD_MINUTES=360

# --- Search engines ---------------------------------------------------------------------------------------------
# Staging must stay out of search results: keep false.
REELGUO_ALLOW_INDEXING=false

# --- Official addresses shown on the site (optional) ------------------------------------------------------------
REELGUO_PERMANENT_DOMAIN=
REELGUO_TELEGRAM=
REELGUO_CONTACT_EMAIL=

# --- Payments (optional, off) -------------------------------------------------------------------------------------
# To try the store with the sandbox provider (anyone can "pay"; never in production):
#   REELGUO_BILLING_ENABLED=true  REELGUO_PAYMENT_PROVIDER=sandbox  REELGUO_ALLOW_SANDBOX_PAYMENTS=true
#   REELGUO_SANDBOX_SECRET=<long random string>
REELGUO_BILLING_ENABLED=false
REELGUO_PAYMENT_PROVIDER=
REELGUO_ALLOW_SANDBOX_PAYMENTS=false
REELGUO_SANDBOX_SECRET=
REELGUO_BILLING_DESCRIPTOR=

# --- Backups ----------------------------------------------------------------------------------------------------
# Nightly database backups in C:\reelguo-staging\backups, kept this many days.
REELGUO_BACKUP_KEEP_DAYS=14
