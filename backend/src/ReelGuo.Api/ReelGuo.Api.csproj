<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Write the OpenAPI document to backend/openapi at build time; the web api-client is generated from it. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReelGuo.Data\ReelGuo.Data.csproj" />
  </ItemGroup>

  <!-- The legal pages' text (用户协议, 隐私政策, 内容政策, 充值协议) in each site language, read as legal/<locale>/<slug>.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Legal\Texts\zh-CN\*.md" LogicalName="legal/zh-CN/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Legal\Texts\id\*.md" LogicalName="legal/id/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Legal\Texts\vi\*.md" LogicalName="legal/vi/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Legal\Texts\pt-BR\*.md" LogicalName="legal/pt-BR/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The server's viewer-facing text in each site language (Brand.cs SiteText), read as texts/<locale>.json. -->
  <ItemGroup>
    <EmbeddedResource Include="Sites\Texts\*.json" LogicalName="texts/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Each site's iPhone home-screen icon in the install profile (Apps/WebClipProfile.cs), read as apps/webclip/<site>.png;
       scripts/brand-icons.mjs writes them. -->
  <ItemGroup>
    <EmbeddedResource Include="Apps\WebClip\*.png" LogicalName="apps/webclip/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
