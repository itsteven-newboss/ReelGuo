{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReelGuo",
  "version": "0.6.0",
  "identifier": "com.reelguo.player",
  "build": {
    "frontendDist": "../boot"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Entertainment",
    "shortDescription": "ReelGuo 短剧",
    "longDescription": "ReelGuo 短剧客户端（仅限 18 岁以上成年人）。",
    "copyright": "© ReelGuo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGQzYxNjQ1MEM4RDdBRTgKUldUb2VvME1SUmJHSDNPY1EvbUVZR2VES2FiU3JtUmNHSnE5VTJzNTVVd3hid2FXS2krVnZlMDAK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
